{
  "compilerOptions": {
    "target":"ES2022",
    "module":"ESNext",
    "moduleResolution":"bundler",
    "lib":["ES2022","DOM","DOM.Iterable"],
    "resolveJsonModule":true,
    "isolatedModules":true,
    "allowJs":true,
    "checkJs":false,
    "strict":true,
    "verbatimModuleSyntax":true,
    "noEmit":true,
    "skipLibCheck":true,
    "types":["vite/client","vitest/globals"]
  },
  "include":["src/**/*.ts","src/**/*.svelte","tests/**/*.ts","vite.config.ts"]
}
