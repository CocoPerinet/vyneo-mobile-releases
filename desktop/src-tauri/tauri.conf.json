    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0OTU5MzZEMTA0QTM2RUQKUldUdE5rb1FiWk9WaE43WU9KT0lVN2VJNTBlcU8wYkpXRG9WNXgzaEtFU2liT2NFdUIzczVGckYK",
      "endpoints": [
        "https://raw.githubusercontent.com/CocoPerinet/vyneo-mobile-releases/main/desktop-{{target}}-{{arch}}.json"
